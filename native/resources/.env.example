# Beyond Compare MCP — environment template (copy to .env, never commit .env)
# See docs/CONFIGURATION.md for the full reference.

# Optional: path to the Beyond Compare executable (auto-detected if empty)
BEYOND_COMPARE_PATH=

# Optional: log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Optional: directory for temporary Beyond Compare script files
BC_SCRIPTS_DIR=./bc_scripts

# Optional: subprocess timeout in seconds
COMMAND_TIMEOUT=30

# Gateway ports (must match fleet-start.config.ps1 + WEBAPP_PORTS.md 10840/10841)
MCP_PORT=10841
MCP_PATH=/mcp

# Optional: local LLM autodetect override
OLLAMA_BASE_URL=http://127.0.0.1:11434
